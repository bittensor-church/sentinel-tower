          "rawQuery": true,
          "rawSql": "SELECT a.pid, array_to_string(pg_blocking_pids(a.pid), ',') AS blocked_by, a.usename AS role, COALESCE(a.wait_event_type || ':' || a.wait_event, '-') AS wait, round(EXTRACT(EPOCH FROM (now() - a.query_start))::numeric, 1) AS age_s, left(regexp_replace(a.query, '\\s+', ' ', 'g'), 120) AS query FROM pg_stat_activity a WHERE cardinality(pg_blocking_pids(a.pid)) > 0 ORDER BY a.query_start",
