      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgresql"
          },
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE state = 'active') AS active, count(*) FILTER (WHERE state = 'idle') AS idle, count(*) FILTER (WHERE state LIKE 'idle in transaction%') AS idle_in_txn, count(*) FILTER (WHERE wait_event_type = 'Lock') AS waiting_on_lock, round(100.0 * count(*) FILTER (WHERE backend_type = 'client backend') / current_setting('max_connections')::int, 1) AS client_backends_pct, current_setting('max_connections')::int AS max_connections FROM pg_stat_activity",
          "refId": "A",
          "format": "table"
        }
      ],
      "title": "Backends",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "postgresql"
      },
      "description": "Client backends whose current statement started more than 2 s ago, oldest first. Includes 'idle in transaction' sessions on purpose: for those, age_s is time since their last statement, and a long idle transaction blocks vacuum. Text cut at 120 characters. Empty is the normal state.",
