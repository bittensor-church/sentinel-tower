            "editorMode": "code",
            "format": "time_series",
            "rawQuery": true,
            "rawSql": "SELECT to_timestamp(bucket_sec) AS time, call_module AS metric, value FROM (SELECT (block_timestamp / 3600000) * 3600 AS bucket_sec, call_module, COUNT(*) AS value FROM extrinsics WHERE block_timestamp >= (extract(epoch from now() - interval '24 hours') * 1000)::bigint AND ('${netuid:csv}' = '*' OR netuid::text = ANY (string_to_array('${netuid:csv}', ','))) AND ('${status:csv}' = '*' OR success::text = ANY (string_to_array('${status:csv}', ','))) AND ('${call_module:csv}' = '*' OR call_module = ANY (string_to_array('${call_module:csv}', ','))) AND ('${call_function:csv}' = '*' OR call_function = ANY (string_to_array('${call_function:csv}', ','))) AND ('${address:csv}' = '*' OR address = ANY (string_to_array('${address:csv}', ','))) GROUP BY 1, 2) hourly ORDER BY time",
            "refId": "A",
            "sql": {
              "columns": [
                {
                  "parameters": [],
                  "type": "function"
                }
