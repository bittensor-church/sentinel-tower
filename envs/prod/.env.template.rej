diff a/envs/prod/.env.template b/envs/prod/.env.template	(rejected hunks)
@@ -45,6 +45,14 @@ DEFAULT_FROM_EMAIL=
 
 SENTRY_DSN=
 PROMETHEUS_EXPORT_MIGRATIONS=1
+# Optional dedicated read-only role for the postgres-exporter container, so DB usage
+# by the monitoring can be told apart from the application's. Fill BOTH or NEITHER
+# (e.g. postgres_exporter + a password), then create the role — automatic on a fresh
+# database, else see db/init/README.md. Left blank, the exporter connects as POSTGRES_USER.
+POSTGRES_EXPORTER_USER=
+POSTGRES_EXPORTER_PASSWORD=
+# statements exported from pg_stat_statements, top by total time (default 300)
+POSTGRES_EXPORTER_STAT_STATEMENTS_LIMIT=
 HTTPS_REDIRECT=1
 
 MEDIA_ROOT=/var/media
