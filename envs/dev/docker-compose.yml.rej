diff a/envs/dev/docker-compose.yml b/envs/dev/docker-compose.yml	(rejected hunks)
@@ -21,6 +21,18 @@ services:
       - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
     volumes:
       - ./db/data:/var/lib/postgresql/data
+      # first-boot SQL, run only when the data directory is initialised; see db/init/README.md
+      - ./db/init:/docker-entrypoint-initdb.d:ro
+    command:
+      - postgres
+      # pg_stat_statements must be preloaded to record per-query timings; query it via
